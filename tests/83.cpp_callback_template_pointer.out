@[translated]
module main

#include "@DIR/c2v_gc_threads.inc"

fn C.c2v_gc_register_thread()
fn C.c2v_gc_allow_threads()

fn c2v_gc_register_thread() {
	$if gcboehm ? {
		C.c2v_gc_register_thread()
	}
}

fn c2v_gc_allow_threads() {
	$if gcboehm ? {
		C.c2v_gc_allow_threads()
	}
}

// External type declarations (from headers)
struct Bag_int {}

struct Owner {
}

type Handler_t = fn (&Owner, &Bag_int)

struct Entry {
	handler Handler_t
}

fn handle(arg &Owner, arg_2 &Bag_int) {
	c2v_gc_register_thread()
}

@[export: 'entries']
const entries = [Entry{
	handler: handle
}]!

fn init() {
	c2v_gc_allow_threads()
}
