@[translated]
module main

#include "@DIR/c2v_gc_threads.inc"

fn C.c2v_gc_register_thread()
fn C.c2v_gc_allow_threads()

fn c2v_gc_register_thread() {
	$if gcboehm ? {
		C.c2v_gc_register_thread()
	}
}

fn c2v_gc_allow_threads() {
	$if gcboehm ? {
		C.c2v_gc_allow_threads()
	}
}

struct Loop_interface_t {
	processEvents fn ()
	runMenu       fn ()
}

@[c:'D_ProcessEvents']
fn d_process_events() {
	c2v_gc_register_thread()
}

@[c:'M_Ticker']
fn m_ticker() {
	c2v_gc_register_thread()
}

fn register_loop(i &Loop_interface_t)

@[weak]
__global doom_loop_interface = Loop_interface_t{
	processEvents: d_process_events
	runMenu:       m_ticker
}

fn setup() {
	register_loop(&doom_loop_interface)
}

fn init() {
	c2v_gc_allow_threads()
}
