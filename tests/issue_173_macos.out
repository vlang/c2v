@[translated]
module main

// C-linkage functions supplied by external libraries
fn C.__assert_rtn(&i8, &i8, i32, &i8)
fn C.getenv(&i8) &i8
fn C.printf(&i8, ...voidptr) i32

#include <assert.h>
#include <stdio.h>
#include <stdlib.h>

fn c2v_prefix_add[T](target &T, delta T) T {
	unsafe {
		*target += delta
		return *target
	}
}

fn main() {
	mut checked := i32(0)
	if (i64(!(c2v_prefix_add(unsafe { &checked }, i32(1)) == 1))) {
		C.__assert_rtn(unsafe { &i8(&c'main'[0]) }, c'issue_173_macos.c', 7, c'++checked == 1')
	} else {
	}
	value := (if true {
		if (i64(!(c2v_prefix_add(unsafe { &checked }, i32(1)) == 2))) {
			C.__assert_rtn(unsafe { &i8(&c'main'[0]) }, c'issue_173_macos.c', 8, c'++checked == 2')
		} else {
		}
		7
	} else {
		0
	})
	loops := i32(0)

	for loops < 2 {
		loops++
		unsafe {
			goto c2v_for_next_1
		}

		c2v_for_next_1:
		if (i64(!(c2v_prefix_add(unsafe { &checked }, i32(1)) <= 4))) {
			C.__assert_rtn(unsafe { &i8(&c'main'[0]) }, c'issue_173_macos.c', 10, c'++checked <= 4')
		} else {
		}
	}
	sequenced := i32(0)
	i := i32(0)
	for i < 2 {
		sequenced += checked
		if (i64(!(c2v_prefix_add(unsafe { &checked }, i32(1)) <= 6))) {
			C.__assert_rtn(unsafe { &i8(&c'main'[0]) }, c'issue_173_macos.c', 15, c'++checked <= 6')
		} else {
		}
		i++
	}
	C.printf(c'%d %d %d %d\n', checked, value, loops, sequenced)
	if C.getenv(c'C2V_ASSERT_FAIL') {
		if (i64(!0)) {
			C.__assert_rtn(unsafe { &i8(&c'main'[0]) }, c'issue_173_macos.c', 19, c'0')
		} else {
		}
	}
	return
}
