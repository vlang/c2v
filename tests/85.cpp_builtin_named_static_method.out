@[translated]
module main

struct MathHelpers {}

fn math_helpers_sqrt(value f32) f32 {
	return value
}

fn math_helpers_sqrt2(value int) f32 {
	return value + 1
}

fn call_sqrt_method(value f32) f32 {
	return math_helpers_sqrt(value)
}

fn call_sqrt_int_method(value int) f32 {
	return math_helpers_sqrt2(value)
}
