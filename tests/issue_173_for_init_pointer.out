fn C.printf(&i8, ...voidptr) i32

#include <stdio.h>

fn main() {
	value := i32(0)
	ptr := &value
	i := i32(0)
	unsafe { (*ptr)++ }
	for i = 0; i < 1; i++ {
	}
	unsafe { (*ptr)++ }
	unsafe { (*ptr)-- }
	unsafe { (*ptr)++ }
	for i = 0; i < 1; i++ {
	}
	i = 0
	unsafe { (*ptr)++ }
