@[translated]
module main

fn c2v_pointer_postfix[T](storage voidptr, pointer &T, delta isize) &T {
	mut __c2v_lhs_tmp_0 := unsafe { &&T(storage) }
	unsafe { *__c2v_lhs_tmp_0 = pointer + delta }
	old := pointer
	return old
}

fn c2v_pointer_prefix[T](storage voidptr, pointer &T, delta isize) &T {
	updated := unsafe { pointer + delta }
	mut __c2v_lhs_tmp_1 := unsafe { &&T(storage) }
	unsafe { *__c2v_lhs_tmp_1 = updated }
	return updated
}

// External C type declarations (from headers)
struct C.Patch {}

@[markused; weak]
__global names = [c'ONE', c'TWO', 0]!

@[export: 'label']
const label = c'READY'

@[c2v_variadic]
fn log_name(fmt &i8, ...)

fn take_patches(values &&C.Patch)

type Load_callback_t = fn (&i8, &&C.Patch)

@[export: 'splat']
const splat = [0, 0]

fn count_names(values &&u8) int {
	check := values
	for (unsafe { *check }) != 0 {
		c2v_pointer_postfix(voidptr(&check), check, isize(1))
	}
	return int((isize(check) - isize(values)) / isize(sizeof(u8)))
}

fn count_global_names() int {
	return count_names(&&u8(&names[0]))
}

fn count_global_names_local() int {
	check := unsafe { &&u8(&names[0]) }
	return count_names(check)
}

fn count_shifted_names(values &&u8) int {
	check := values
	for check = unsafe { check + 1 }; (unsafe { *check }); check = unsafe { check + 1 } {
	}
	return int((isize(check) - isize(values)) / isize(sizeof(u8)))
}

fn consume_name(text &i8) int {
	c := i8(0)
	for c = *text; c; c = *(c2v_pointer_prefix(voidptr(&text), text, isize(1))) {
	}
	return int(c)
}

fn log_label() {
	log_name(c'%s', label)
}

fn pass_patch_array() {
	take_patches(&&C.Patch(&splat[0]))
}

fn pass_patch_slot(callback Load_callback_t) {
	callback(c'SPLAT', &&C.Patch(unsafe { &splat[0] + 0 }))
}
