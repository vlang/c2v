@[translated]
module main

fn c2v_pointer_postfix[T](pointer &&T, delta isize) &T {
	old := unsafe { *pointer }
	unsafe { *pointer = old + delta }
	return old
}

fn c2v_pointer_prefix[T](pointer &&T, delta isize) &T {
	unsafe { *pointer = *pointer + delta }
	return unsafe { *pointer }
}

// External C type declarations (from headers)
struct C.Patch {}

@[markused; weak]
__global names = [c'ONE', c'TWO', 0]!

@[export: 'label']
const label = c'READY'

@[c2v_variadic]
fn log_name(fmt &i8, ...)

fn take_patches(values &&C.Patch)

type Load_callback_t = fn (&i8, &&C.Patch)

@[export: 'splat']
const splat = [0, 0]

fn count_names(values &&u8) int {
	check := values
	for (unsafe { *check }) != 0 {
		c2v_pointer_postfix(&check, isize(1))
	}
	return int((isize(check) - isize(values)) / isize(sizeof(u8)))
}

fn count_global_names() int {
	return count_names(&&u8(&names[0]))
}

fn count_global_names_local() int {
	check := unsafe { &&u8(&names[0]) }
	return count_names(check)
}

fn count_shifted_names(values &&u8) int {
	check := values
	for check = unsafe { check + 1 }; (unsafe { *check }); check = unsafe { check + 1 } {
	}
	return int((isize(check) - isize(values)) / isize(sizeof(u8)))
}

fn consume_name(text &i8) int {
	c := i8(0)
	for c = *text; c; c = *(c2v_pointer_prefix(&text, isize(1))) {
	}
	return c
}

fn log_label() {
	log_name(c'%s', label)
}

fn pass_patch_array() {
	take_patches(&&C.Patch(&splat[0]))
}

fn pass_patch_slot(callback Load_callback_t) {
	callback(c'SPLAT', &&C.Patch(&splat[0]))
}
