@[translated]
module main

fn sum_nested_array() i32 {
	static neighbors := [[i32(0), 1], [i32(1), -1]]

	return neighbors[0][1] + neighbors[1][0]
}

fn first_zero_value() f32 {
	vector := [3]f32{}
	return vector[0]
}

struct GlobalCell {
	value f32
}

fn (mut this GlobalCell) init() {
}

@[export: 'global_cells']
const global_cells = [2]GlobalCell{}

fn read_global_cell() f32 {
	return global_cells[1].value
}

type Word = u32

@[export: 'global_words']
const global_words = [Word(255), Word(0)]

fn read_global_word(index i32) Word {
	return global_words[index]
}
