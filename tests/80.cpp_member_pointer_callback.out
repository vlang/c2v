@[translated]
module main

fn C.GC_thread_is_registered() int

fn C.GC_allow_register_threads()

fn C.pthread_key_create(voidptr, voidptr) int

fn C.pthread_setspecific(usize, voidptr) int

__global c2v_gc_thread_key = u64(0)

fn c2v_gc_thread_exit(value voidptr) {
	$if gcboehm ? {
		C.GC_unregister_my_thread()
	}
}

fn c2v_gc_register_thread() {
	$if gcboehm ? {
		if C.GC_thread_is_registered() != 0 {
			return
		}
		// (Room for a `struct GC_stack_base`.)
		mut base := [4]voidptr{}
		if C.GC_get_stack_base(voidptr(&base[0])) != 0 {
			return
		}
		C.GC_register_my_thread(voidptr(&base[0]))
		$if !windows {
			// Unregister the thread when it exits.
			if c2v_gc_thread_key == 0 {
				C.pthread_key_create(voidptr(&c2v_gc_thread_key), voidptr(c2v_gc_thread_exit))
			}
			C.pthread_setspecific(usize(c2v_gc_thread_key), voidptr(1))
		}
	}
}

fn c2v_gc_allow_threads() {
	$if gcboehm ? {
		C.GC_allow_register_threads()
	}
}

fn c2v_member_fn_callback_owner_invoke(mut c2v_this CallbackOwner, c2v_arg_0 int) {
	c2v_this.invoke(c2v_arg_0)
}

fn c2v_member_fn_callback_owner_empty(mut c2v_this CallbackOwner) {
}

struct CallbackBase {}

type Callback_t = voidptr

struct CallbackEntry {
	function Callback_t
}

struct CallbackOwner {
	CallbackBase
	last int
}

fn (mut this CallbackOwner) invoke(value int) {
	c2v_gc_register_thread()
	this.last = value
}

fn (this &CallbackOwner) empty() {
	c2v_gc_register_thread()
}

@[export: 'callbacks']
const callbacks = [CallbackEntry{
	function: Callback_t(voidptr(c2v_member_fn_callback_owner_invoke))
}, CallbackEntry{
	function: Callback_t(voidptr(c2v_member_fn_callback_owner_empty))
}]!

fn main() {
	return
}

fn init() {
	c2v_gc_allow_threads()
}
