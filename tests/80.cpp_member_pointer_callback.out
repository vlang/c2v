@[translated]
module main

struct CallbackBase {}

type Callback_t = voidptr

struct CallbackEntry {
	function Callback_t
}

struct CallbackOwner {
	CallbackBase
	last int
}

fn (mut this CallbackOwner) invoke(value int) {
	this.last = value
}

fn (this CallbackOwner) empty() {
}

@[export: 'callbacks']
const callbacks = [CallbackEntry{
	function: Callback_t(fn (mut c2v_this CallbackOwner, c2v_arg_0 int) {
		c2v_this.invoke(c2v_arg_0)
	})
}, CallbackEntry{
	function: Callback_t(fn (mut c2v_this CallbackOwner) {})
}]

