@[translated]
module main

#include "@DIR/c2v_gc_threads.inc"

fn C.c2v_gc_register_thread()
fn C.c2v_gc_allow_threads()

fn c2v_gc_register_thread() {
	$if gcboehm ? {
		C.c2v_gc_register_thread()
	}
}

fn c2v_gc_allow_threads() {
	$if gcboehm ? {
		C.c2v_gc_allow_threads()
	}
}

fn c2v_member_fn_callback_owner_invoke(mut c2v_this CallbackOwner, c2v_arg_0 i32) {
	c2v_this.invoke(c2v_arg_0)
}

fn c2v_member_fn_callback_owner_empty(mut c2v_this CallbackOwner) {
}

struct CallbackBase {
}

type Callback_t = voidptr

struct CallbackEntry {
	function Callback_t
}

struct CallbackOwner {
	CallbackBase
	last i32
}

fn (mut this CallbackOwner) invoke(value i32) {
	c2v_gc_register_thread()
	this.last = value
}

fn (this &CallbackOwner) empty() {
	c2v_gc_register_thread()
}

@[export: 'callbacks']
const callbacks = [CallbackEntry{
	function: Callback_t(voidptr(c2v_member_fn_callback_owner_invoke))
}, CallbackEntry{
	function: Callback_t(voidptr(c2v_member_fn_callback_owner_empty))
}]!

fn main() {
	exit(sizeof([2]CallbackEntry) == 0)
}

fn init() {
	c2v_gc_allow_threads()
}
