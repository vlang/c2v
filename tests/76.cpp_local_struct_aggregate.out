@[translated]
module main

#include <stdio.h>

struct Builtin {
	string_ &i8
	id      i32
}

fn local_struct_value() i32 {
	mut builtin := [Builtin{
		string_: c'first'
		id: 7
	}, Builtin{
		string_: unsafe { nil }
		id: 0
	}]

	return builtin[0].id
}

fn main() {
	C.printf(c'%d\n', local_struct_value())
	return
}
