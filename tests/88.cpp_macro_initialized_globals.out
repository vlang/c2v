@[translated]
module main

@[markused; weak]
__global first = &int(unsafe { nil })
@[markused; weak]
__global second = &int(unsafe { nil })
@[markused; weak]
__global upperGlobal = &int(unsafe { nil })

fn globals_are_null() int {
	return int(usize(first) == usize(unsafe { nil }) && usize(second) == usize(unsafe { nil }) && usize(upperGlobal) == usize(unsafe { nil }))
}