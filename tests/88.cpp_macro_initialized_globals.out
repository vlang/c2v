@[translated]
module main

@[markused; weak]
__global first = &i32(unsafe { nil })
@[markused; weak]
__global second = &i32(unsafe { nil })
@[markused; weak]
__global upperGlobal = &i32(unsafe { nil })

fn globals_are_null() i32 {
	return i32(usize(first) == usize(unsafe { nil }) && usize(second) == usize(unsafe { nil }) && usize(upperGlobal) == usize(unsafe { nil }))
}
