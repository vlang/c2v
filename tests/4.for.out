@[translated]
module main

// C-linkage functions supplied by external libraries
fn C.printf(&i8, ...voidptr) int

#include <stdio.h>

fn for_test() {
	for i := 0; i < 10; i++ {
		C.printf(c'i = %d\n', i)
	}
	for i := 0; i < 10; i++ {
		C.printf(c'single line')
	}
	//
	x := 1
	sum := 0
	for x < 10 {
		x++
		sum += x
	}
	//
	for {
		C.printf(c'inf loop')
		break
	}
}
