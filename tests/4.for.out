@[translated]
module main

// C-linkage functions supplied by external libraries
fn C.printf(&i8, ...voidptr) i32

#include <stdio.h>

fn for_test() {
	for i := i32(0); i < 10; i++ {
		C.printf(c'i = %d\n', i)
	}
	for i := i32(0); i < 10; i++ {
		C.printf(c'single line')
	}
	//
	x := i32(1)
	sum := i32(0)
	for x < 10 {
		x++
		sum += x
	}
	//
	for {
		C.printf(c'inf loop')
		break
	}
}
