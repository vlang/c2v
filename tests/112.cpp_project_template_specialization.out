@[translated]
module main

struct TinyArray_int_4 {
	values     [4]int
	size_value int
}

fn (mut this TinyArray_int_4) init() {
	this.size_value = 0
}

fn (mut this TinyArray_int_4) push_back(value int) {
	this.values[this.size_value] = value
	this.size_value++
}

fn (this &TinyArray_int_4) op_index(index int) &int {
	return unsafe { &this.values[index] }
}

fn (this &TinyArray_int_4) size() int {
	return this.size_value
}

type TinyInts = TinyArray_int_4

fn project_template_value() int {
	mut values := TinyInts{}
	values.init()

	values.push_back(7)
	return unsafe { *(values.op_index(0)) } + values.size()
}
