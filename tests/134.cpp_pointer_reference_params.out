@[translated]
module main

fn swap_values_int(a &i32, b &i32) {
	c := unsafe { *a }
	unsafe { *a = *b }
	unsafe { *b = c }
}

fn swap_values_int_ptr(a &&i32, b &&i32) {
	c := unsafe { *a }
	unsafe { *a = *b }
	unsafe { *b = c }
}

struct Link {
	value i32
	next  &Link
}

fn set_link(cursor &&Link, target &Link) {
	unsafe { *cursor = target }
}

fn advance(cursor &&Link) i32 {
	value := (unsafe { *cursor }).value
	set_link(cursor, (unsafe { *cursor }).next)
	return value
}

fn peek(value i32) i32 {
	copy := value
	return copy + value
}

struct Walker {
	at &Link
}

fn (mut this Walker) step() i32 {
	return advance(&this.at)
}

fn (this &Walker) read() i32 {
	return peek(this.at.value)
}

fn swap_both(a &i32, b &i32) i32 {
	swap_values_int((unsafe { *a }), (unsafe { *b }))
	swap_values_int_ptr(&a, &b)
	return unsafe { *a }
}
