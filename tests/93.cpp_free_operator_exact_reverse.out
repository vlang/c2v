@[translated]
module main

struct Vector {
	x f32
}

struct Matrix {}

fn (this Matrix) op_mul(value &Vector) Vector {
	return Vector{
		x: value.x * f32(2)
	}
}

fn cpp_free_op_mul(value &Vector, matrix &Matrix) Vector {
	return matrix.op_mul(value)
}

fn cpp_free_op_mul_assign(value &Vector, matrix &Matrix) &Vector {
	unsafe { *value = matrix.op_mul(value) }
	return unsafe { &value }
}

fn reverse_product(value &Vector, matrix &Matrix) Vector {
	return cpp_free_op_mul(value, matrix)
}

fn reverse_assign(value &Vector, matrix &Matrix) {
	cpp_free_op_mul_assign(value, matrix)
}

fn reverse_assign_local(matrix &Matrix) {
	mut value := Vector{}

	cpp_free_op_mul_assign(&value, matrix)
}

fn same_vector(value &Vector) &Vector {
	return unsafe { &value }
}

fn reverse_reference(value &Vector, matrix &Matrix) Vector {
	return cpp_free_op_mul(same_vector(value), matrix)
}

fn reverse_temporary(matrix &Matrix) Vector {
	__c2v_arg_0 := Vector{}
	return cpp_free_op_mul(&__c2v_arg_0, matrix)
}

fn reverse_nested_temporary(matrix &Matrix) Vector {
	__c2v_arg_2 := Vector{}
	__c2v_arg_1 := (cpp_free_op_mul(&__c2v_arg_2, matrix))
	return cpp_free_op_mul(&__c2v_arg_1, matrix)
}
