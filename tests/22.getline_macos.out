@[translated]
module main

// C-linkage functions supplied by external libraries
fn C.free(voidptr)
fn C.getline(&&u8, &usize, &C.FILE) isize
fn C.printf(&i8, ...voidptr) i32

#include <stdio.h>
#include <stdlib.h>

fn c2v_address_of(address voidptr) voidptr {
	return address
}

fn main() {
	input := unsafe { &i8(nil) }
	len := usize(0)
	read := isize(0)
	C.printf(c'Enter text (Ctrl+D to quit):\n')
	read = C.getline(&&u8(&&i8(c2v_address_of(&input))), &len, C.stdin)
	if read != isize(-1) {
		C.printf(c'Entered: %s', input)
	} else {
		C.printf(c'error reading input\n')
	}
	C.free(voidptr(input))
	return
}
