@[translated]
module main

#include <stdio.h>

struct C2vVaList {
	args []voidptr
mut:
	index int
}

fn c2v_va_start(args []voidptr) &C2vVaList {
	return &C2vVaList{
		args: args
	}
}

fn c2v_va_copy(ap &C2vVaList) &C2vVaList {
	if isnil(ap) {
		return unsafe { nil }
	}
	return &C2vVaList{
		args: ap.args
		index: ap.index
	}
}

fn c2v_va_end(ap &C2vVaList) {}

fn c2v_va_arg(ap &C2vVaList) voidptr {
	if isnil(ap) || ap.index >= ap.args.len {
		return unsafe { nil }
	}
	value := ap.args[ap.index]
	ap.index++
	return value
}

// c2v_va_rest returns the arguments that remain to be read.
fn c2v_va_rest(ap &C2vVaList) []voidptr {
	if isnil(ap) || ap.index >= ap.args.len {
		return []voidptr{}
	}
	return ap.args[ap.index..]
}

fn c2v_va_is_immediate(raw usize) bool {
	return raw < usize(1048576) || raw > ~usize(0) - usize(1048576)
}

fn c2v_va_integer(ap &C2vVaList, wide bool) i64 {
	arg := c2v_va_arg(ap)
	if c2v_va_is_immediate(usize(arg)) {
		return i64(isize(usize(arg)))
	}
	if wide {
		return unsafe { *(&i64(arg)) }
	}
	return i64(unsafe { *(&int(arg)) })
}

fn c2v_va_float(ap &C2vVaList) f64 {
	arg := c2v_va_arg(ap)
	if c2v_va_is_immediate(usize(arg)) {
		return f64(isize(usize(arg)))
	}
	return unsafe { *(&f64(arg)) }
}

fn c2v_construct_id_bounds_init1(point &IdVec3) IdBounds {
	mut c2v_ctor_value := &IdBounds{}
	c2v_ctor_value.init1(point)
	return unsafe { *c2v_ctor_value }
}

fn c2v_construct_id_bounds_init2(mins &IdVec3, maxs &IdVec3) IdBounds {
	mut c2v_ctor_value := &IdBounds{}
	c2v_ctor_value.init2(mins, maxs)
	return unsafe { *c2v_ctor_value }
}

fn id_swap_int(left &int, right &int) {
	temporary := unsafe { *left }
	unsafe { *left = *right }
	unsafe { *right = temporary }
}

struct SwapBag {
	value int
}

fn (mut this SwapBag) swap(other &SwapBag) {
	id_swap_int(this.value, other.value)
}

struct ParserValue {
	parsed int
}

fn (mut this ParserValue) parse(source &int) bool {
	this.parsed += (unsafe { *source })
	return true
}

struct ParserHolder {
	values [1]ParserValue
}

fn is_ready(ready bool) bool {
	return ready
}

fn parse_after_condition(holder &ParserHolder, ready bool, source &int) bool {
	if !is_ready(ready) || !holder.values[0].parse(source) {
		return false
	}
	return true
}

struct BitReader {
	bit int
}

fn (mut this BitReader) get_bit() int {
	this.bit++
	return this.bit
}

fn (mut this BitReader) combine(value int) int {
	return (value << 1) + this.get_bit()
}

fn update_references(offset &int, count &int) bool {
	unsafe { *offset = 3 }
	unsafe { *count += *offset }
	return unsafe { *count } * 2 > 0
}

fn call_update_references() bool {
	offset := 0
	count := 1
	return update_references(offset, count)
}

struct PointerNode {
	value int
}

struct PointerNodeList {
	items &&PointerNode
}

fn (this &PointerNodeList) op_index(index int) &&PointerNode {
	return unsafe { &this.items[index] }
}

fn pointer_index_is_set(list &PointerNodeList) bool {
	return usize((unsafe { *list.op_index(0) })) != usize(0)
}

type Joint_callback_t = fn (int) bool

fn get_joint_transform(value int) bool {
	return value != 0
}

fn invoke_callback(get_joint_transform_callback Joint_callback_t) bool {
	return get_joint_transform_callback(1)
}

fn consume_list(format &i8, args &C2vVaList) int {
	return int(c2v_va_integer(args, false))
}

fn forward_list(format &i8, c2v_variadic_args ...voidptr) int {
	args := &C2vVaList(0)
	args = c2v_va_start(c2v_variadic_args)
	result := consume_list(format, args)
	c2v_va_end(args)
	return result
}

struct IdStr {
	data &i8
}

fn (this &IdStr) c_str() &i8 {
	return this.data
}

fn (this &IdStr) op_conv_const_char_ptr() &i8 {
	return this.data
}

struct IdToken {
	IdStr
}

fn atof(text &i8) f64

fn parse_token(token &IdToken) f64 {
	return atof(token.op_conv_const_char_ptr())
}

fn subtract_text_pointers(left &IdStr, right &IdStr) int {
	return int(i64((isize((unsafe { *left }).op_conv_const_char_ptr()) - isize((unsafe { *right }).op_conv_const_char_ptr())) / isize(sizeof(i8))))
}

struct IdVec3 {
	x f32
	y f32
	z f32
}

struct IdBounds {
	b [2]IdVec3
}

fn (mut this IdBounds) init1(point &IdVec3) {
	this.b[0] = point
	this.b[1] = point
}

fn (mut this IdBounds) init2(mins &IdVec3, maxs &IdVec3) {
	this.b[0] = mins
	this.b[1] = maxs
}

fn construct_point_bounds(point IdVec3) IdBounds {
	return c2v_construct_id_bounds_init1(&point)
}

fn construct_range_bounds(mins IdVec3, maxs IdVec3) IdBounds {
	return c2v_construct_id_bounds_init2(&mins, &maxs)
}

fn default_case_fallthrough(value int) int {
	match value {
		0 { // case comp body kind=ReturnStmt is_enum=false
			return 10
		}
		2 { // case comp body kind=ReturnStmt is_enum=false
			return 30
		}
		1 { // case comp body kind=ReturnStmt is_enum=false
			return 20
		}
		else {
			return 20
		}
	}
}

fn default_case_trailing_statements(value int) int {
	result := 0
	match value {
		2 { // case comp body kind=BinaryOperator is_enum=false
			result = 30
		}
		1 { // case comp body kind=BinaryOperator is_enum=false
			result = 20
			result += 1
		}
		else {
			result = 20
			result += 1
		}
	}

	return result
}

fn switch_character(value i8) int {
	match int(value) {
		int(`a`) { // case comp body kind=ReturnStmt is_enum=false
			return 1
		}
		int(`%`) { // case comp body kind=ReturnStmt is_enum=false
			return 2
		}
		else {
			return 0
		}
	}
}

struct ChecksumFile {
	checksum int
}

fn (mut this ChecksumFile) reload(force bool) {
	if force {
		this.load()
	}
}

fn (mut this ChecksumFile) load() {
	this.checksum++
}

struct ChecksumFileList {
	items &&ChecksumFile
}

fn (this &ChecksumFileList) op_index(index int) &ChecksumFile {
	return this.items[index]
}

fn (this &ChecksumFileList) op_index2(index int) &&ChecksumFile {
	return unsafe { &this.items[index] }
}

struct ChecksumOwner {
	checksum int
	files    ChecksumFileList
}

fn (mut this ChecksumOwner) reload_file(force bool) {
	this.checksum ^= (unsafe { *this.files.op_index2(0) }).checksum
	mut __c2v_mut_recv_0 := this.files.op_index2(0)
	__c2v_mut_recv_0.reload(force)
	this.checksum ^= (unsafe { *this.files.op_index2(0) }).checksum
}

struct OpaqueState {}

enum LinkStatus {
	link_status_bad = -1
	link_status_ok  = 0
}

struct LinkPayload {
	state  &OpaqueState
	status LinkStatus
}

fn return_from_endless_loop(value int) int {
	for {
		if (value != 0) {
			return 1
		}
		return 0
	}
	panic('unreachable after C for (;;)')
}

fn narrow_ftell(file &C.FILE) int {
	return int(C.ftell(file))
}

struct FloatBuffer {
	values &f32
}

fn (this &FloatBuffer) op_index(index int) &f32 {
	return unsafe { &this.values[index] }
}

fn scale_buffer_value(buffer &FloatBuffer, index int) int {
	return int(((unsafe { *(buffer.op_index(index)) }) * 2.0))
}

fn assign_buffer_value(buffer &FloatBuffer, index int, value f32) {
	mut __c2v_lhs_tmp_1 := buffer.op_index(index)
	unsafe { *__c2v_lhs_tmp_1 = value }
}

fn increment_buffer_reference(value &f32) {
	unsafe { *value += 1.0 }
}

fn pass_buffer_reference(buffer &FloatBuffer, index int) {
	increment_buffer_reference(buffer.op_index(index))
}

fn address_buffer_value(buffer &FloatBuffer, index int) &f32 {
	return buffer.op_index(index)
}

