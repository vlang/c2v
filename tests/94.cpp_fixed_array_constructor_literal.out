@[translated]
module main

fn c2v_construct_vec2_init2(x f32, y f32) Vec2 {
	mut c2v_ctor_value := Vec2{}
	c2v_ctor_value.init2(x, y)
	return c2v_ctor_value
}

fn c2v_construct_mat2_init2(x &Vec2, y &Vec2) Mat2 {
	mut c2v_ctor_value := Mat2{}
	c2v_ctor_value.init2(x, y)
	return c2v_ctor_value
}

fn c2v_construct_mat2_init4(xx f32, xy f32, yx f32, yy f32) Mat2 {
	mut c2v_ctor_value := Mat2{}
	c2v_ctor_value.init4(xx, xy, yx, yy)
	return c2v_ctor_value
}

struct Vec2 {
	x f32
	y f32
}

fn (mut this Vec2) init2(x f32, y f32) {
	this.x = x
	this.y = y
}

struct Mat2 {
	rows [2]Vec2
}

fn (mut this Mat2) init2(x &Vec2, y &Vec2) {
	this.rows = [unsafe { *x }, unsafe { *y }]
}

fn (mut this Mat2) init4(xx f32, xy f32, yx f32, yy f32) {
	this.rows = [c2v_construct_vec2_init2(xx, xy), c2v_construct_vec2_init2(yx, yy)]
}

fn from_rows(x &Vec2, y &Vec2) Mat2 {
	return c2v_construct_mat2_init2(x, y)
}

fn from_scalars() Mat2 {
	return c2v_construct_mat2_init4(f32(1), f32(2), f32(3), f32(4))
}
