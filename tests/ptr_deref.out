@[translated]
module main

fn c2v_pointer_postfix[T](storage voidptr, pointer &T, delta isize) &T {
	mut __c2v_lhs_tmp_0 := unsafe { &&T(storage) }
	unsafe { *__c2v_lhs_tmp_0 = pointer + delta }
	old := pointer
	return old
}

fn c2v_pointer_prefix[T](storage voidptr, pointer &T, delta isize) &T {
	updated := unsafe { pointer + delta }
	mut __c2v_lhs_tmp_1 := unsafe { &&T(storage) }
	unsafe { *__c2v_lhs_tmp_1 = updated }
	return updated
}

// Test pointer dereference operations
struct Mobj_t {
	value i32
	bnext &Mobj_t
	bprev &Mobj_t
}

fn test_ptr_ops(endptr &&u8, value &i32) {
	// Reading from dereferenced pointer
	if usize((unsafe { *endptr })) != usize((voidptr(0))) {
		// Assigning to dereferenced pointer
		unsafe { *value = 42 }
	}
	abc := i32(123)
	pabc := &abc
	unsafe { *value = *pabc }
	// check `*x = *y = value;`
	count := i32(10)
	dc_colormap := &count
	dc_source := &count
	frac := i32(5)
	fracstep := i32(2)
	fracbits := i32(2)
	dest1 := &i32(0)
	dest2 := &i32(0)
	dest3 := &i32(0)
	for {
		unsafe { *dest1 = dc_colormap[dc_source[(frac >> fracbits) & 127]] }
		unsafe { *dest2 = *dest1 }
		unsafe { *dest3 = *dest2 }
		c2v_pointer_prefix(voidptr(&dest1), dest1, isize(320))
		c2v_pointer_prefix(voidptr(&dest2), dest2, isize(320))
		c2v_pointer_prefix(voidptr(&dest3), dest3, isize(320))
		frac += fracstep
		// while()
		if !(count--) {
			break
		}
	}
	c2v_pointer_postfix(voidptr(&dest1), dest1, isize(1))
	// check chained dereferencing:
	the_thing := Mobj_t{}
	the_thing.value = 456
	thing := &the_thing
	link := &&Mobj_t(0)
	thing.bnext = unsafe { *link }
	if unsafe { *link != nil } {
		unsafe { (*link).bprev = thing }
	}
	unsafe { *link = thing }
}
