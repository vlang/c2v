enum ExecMode {
	exec_now
	exec_later
}

fn switch_exec_mode(mode ExecMode) i32 {
	match mode {
		.exec_now { // case comp body kind=ReturnStmt is_enum=true
			return 1
		}
		.exec_later { // case comp body kind=ReturnStmt is_enum=true
			return 2
		}
		else {}
	}

	return 0
}

