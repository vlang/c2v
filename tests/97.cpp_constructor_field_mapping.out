struct IdToken {
	IdStr
}

fn append_derived_idstr(out &IdStr, token &IdToken) {
	out.op_plus_assign(unsafe { &IdStr(&token) })
}

fn idstr_literal_comparisons(value &IdStr) bool {
	return value.cmp(c'ok') == 0 && value.cmp(c'bad') != 0
}

fn idstr_append_copy(value IdStr, suffix &i8) IdStr {
	return c2v_idstr_plus_text(value, suffix)
}

fn idstr_prepend_copy(prefix &i8, value IdStr) IdStr {
	return c2v_text_plus_idstr(prefix, value)
}

fn construct_idstr(text &i8) IdStr {
	return c2v_construct_id_str(text)
}

type IdStrPtr = &IdStr

fn compare_idstr_pointer_aliases(left &IdStrPtr, right &IdStrPtr) int {
	return (unsafe { *left }).icmp_path((unsafe { **right }).c_str())
}

fn idstr_text(value &IdStr) &i8 {
	return value.c_str()
}

fn accept_text(text &i8) {
}

fn accept_char(value i8) {
}

fn pass_char_literal() {
	accept_char(i8(` `))
	slash := i8(`\\`)
	accept_char(i8(slash))
}

fn pass_text_buffer() {
	text := [8]i8{}
	accept_text(unsafe { &i8(&text[0]) })
}

fn pass_conditional_text(set bool) {
	accept_text(unsafe { if set { c'1' } else { c'0' } })
}

struct IdCmdArgs {
	argc int
}

fn (mut this IdCmdArgs) init2(text &i8, keep_as_strings bool) {
	this.argc = if keep_as_strings { 2 } else { 1 }
}

fn (this IdCmdArgs) first_text(unused bool, c2v_variadic_args ...voidptr) &i8 {
	args := 0
	args = 0
	result := unsafe { &i8(c2v_next_variadic_arg(c2v_variadic_args, &args)) }
	args = args
	return result
}

fn consume_cmd_args(args &IdCmdArgs) int {
	return args.argc
}

fn construct_cmd_args(text &i8) int {
	__c2v_arg_0 := c2v_construct_id_cmd_args(text, false)
	return consume_cmd_args(&__c2v_arg_0)
}

struct NamedBuffer {
