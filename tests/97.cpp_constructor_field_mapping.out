@[translated]
module main

fn c2v_idstr_plus_text(left IdStr, right &i8) IdStr {
	mut result := c2v_construct_id_str(left.c_str())
	result.op_plus_assign2(right)
	return result
}

fn c2v_text_plus_idstr(left &i8, right IdStr) IdStr {
	mut result := c2v_construct_id_str(left)
	result.op_plus_assign(&right)
	return result
}

fn c2v_construct_id_str(text &i8) IdStr {
	mut value := IdStr{}
	value.data = unsafe { nil }
	if text != unsafe { nil } {
		value.len = int(C.strlen(text))
		value.alloced = value.len + 1
		value.data = unsafe { &i8(C.malloc(usize(value.alloced))) }
		C.strcpy(value.data, text)
	}
	return value
}

fn c2v_next_variadic_arg(args []voidptr, index &int) voidptr {
	current := unsafe { *index }
	if current < 0 || current >= args.len {
		return unsafe { nil }
	}
	value := args[current]
	unsafe { *index = current + 1 }
	return value
}

fn c2v_construct_id_cmd_args(text &i8, keep_as_strings bool) IdCmdArgs {
	mut value := IdCmdArgs{}
	value.init2(text, keep_as_strings)
	return value
}

