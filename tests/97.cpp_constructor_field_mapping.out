}

fn pass_indirect_member_buffer(item &&NamedBuffer) {
	accept_text(unsafe { &i8(&(*item).name[0]) })
}

fn pass_text_buffer_to_member(value &IdStr) {
	text := [8]i8{}
	value.append(unsafe { &i8(&text[0]) })
}

