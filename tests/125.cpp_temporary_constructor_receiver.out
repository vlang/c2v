@[translated]
module main

fn c2v_construct_id_str(text &i8) IdStr {
	mut value := IdStr{}
	value.data = unsafe { nil }
	if text != unsafe { nil } {
		value.len = int(C.strlen(text))
		value.alloced = value.len + 1
		value.data = unsafe { &i8(C.malloc(usize(value.alloced))) }
		C.strcpy(value.data, text)
	}
	return value
}

struct IdStr {
	len         int
	alloced     int
	data        &i8
	base_buffer [20]i8
}

fn (mut this IdStr) init1(text &i8) {
}

fn (this IdStr) file_name_hash() int {
	return 7
}

fn hash_name(name &i8) int {
	return c2v_construct_id_str(name).file_name_hash()
}