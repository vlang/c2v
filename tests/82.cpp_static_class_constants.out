@[translated]
module main

@[export: 'StaticValues_INLINE_VALUE']
const static_values_inline_value = 7

struct StaticValues {}

@[export: 'StaticValues_DECLARED_VALUE']
const static_values_declared_value = 3.5

@[markused; weak]
__global static_values_mutable_value = i32(2)

fn static_value_sum() f32 {
	return static_values_inline_value + static_values_declared_value + static_values_mutable_value
}

fn static_value_through_object(values &StaticValues) i32 {
