@[translated]
module main

fn c2v_i32_reference_postfix(value &i32, delta i32) i32 {
	unsafe {
		previous := *value
		*value += delta
		return previous
	}
}

union C2vNilInterfaceStorage[T] {
mut:
	raw   [2]voidptr
	value T
}

struct C2vInterfaceHeader {
	object voidptr
}

fn c2v_nil_interface[T]() T {
	storage := C2vNilInterfaceStorage[T]{}
	return unsafe { storage.value }
}

fn c2v_interface_object[T](value T) voidptr {
	return unsafe { (&C2vInterfaceHeader(&value)).object }
}

fn c2v_interface_is_nil[T](value T) bool {
	return c2v_interface_object(value) == unsafe { nil }
}

fn c2v_interface_ref_object(value voidptr) voidptr {
	return unsafe { (&C2vInterfaceHeader(value)).object }
}

// Reinterprets an address as `&T`. Casting a raw pointer to `&Interface`
// would instead box the pointer into a new interface value.
union C2vPointerStorage[T] {
mut:
	raw   voidptr
	value &T
}

fn c2v_pointer_as[T](raw voidptr) &T {
	mut storage := C2vPointerStorage[T]{
		raw: raw
	}
	return unsafe { storage.value }
}

fn c2v_pointer_at[T](base &T, index isize) &T {
	return c2v_pointer_as[T](unsafe { voidptr(usize(voidptr(base)) + usize(index) * usize(sizeof(T))) })
}

fn c2v_cpp_alloc(count usize, size usize) voidptr {
	bytes := count * size
	memory := unsafe { malloc_uncollectable(isize(if bytes == 0 { 1 } else { bytes })) }
	unsafe { C.memset(memory, 0, bytes) }
	return memory
}

struct TextBuffer {
	data &i8
}

fn (mut this TextBuffer) op_plus_assign(text &i8) &TextBuffer {
	this.data = text
	return unsafe { this }
}

fn (mut this TextBuffer) op_plus_assign2(marker i8) &TextBuffer {
	if (marker != 0) {
		mut __c2v_lhs_tmp_0 := unsafe { &this.data }
		unsafe { *__c2v_lhs_tmp_0 = this.data }
	}
	return unsafe { this }
}

fn append_marker(text &TextBuffer) {
	text.op_plus_assign2(i8(`_`))
}

fn consume_text(text &i8) bool

fn conditional_array_decay(has_key bool) bool {
	key := [4]i8{}
	return consume_text(unsafe { if has_key { &i8(&key[0]) } else { nil } })
}

enum State {
	state_idle
	state_active
}

fn activate() State {
	state := State.state_idle
	mut __c2v_lhs_tmp_1 := unsafe { &state }
	unsafe { *__c2v_lhs_tmp_1 = State.state_active }
	return state
}

type StateChannel = i32

fn consume_state_channel(channel StateChannel)

fn send_state_channel() {
	consume_state_channel(StateChannel(State.state_active))
}

fn consume_const_count(count i32)

fn send_const_count() {
