@[translated]
module main

// C-linkage functions supplied by external libraries
fn C.printf(&i8, ...voidptr) i32

#include <stdio.h>

fn main() {
	if 10 > 5 {
		C.printf(c'10 > 5')
	} else {
		C.printf(c'no')
	}
	x := i32(10)
	y := i32(20)
	if y > x {
		C.printf(c'y > x')
	}
	if y + 1 > x {}
	// TODO
	if 1 {
		C.printf(c'one')
	} else if 1 > 0 || x < y || (x > y && x < y + 1) {
		C.printf(c'two')
		C.printf(c'three')
	}
	return
}
