@[translated]
module main

union C2vNilInterfaceStorage[T] {
mut:
	raw   [2]voidptr
	value T
}

struct C2vInterfaceHeader {
	object voidptr
}

fn c2v_nil_interface[T]() T {
	storage := C2vNilInterfaceStorage[T]{}
	return unsafe { storage.value }
}

fn c2v_interface_object[T](value T) voidptr {
	return unsafe { (&C2vInterfaceHeader(&value)).object }
}

fn c2v_interface_is_nil[T](value T) bool {
	return c2v_interface_object(value) == unsafe { nil }
}

fn c2v_interface_ref_object(value voidptr) voidptr {
	return unsafe { (&C2vInterfaceHeader(value)).object }
}

// Reinterprets an address as `&T`. Casting a raw pointer to `&Interface`
// would instead box the pointer into a new interface value.
union C2vPointerStorage[T] {
mut:
	raw   voidptr
	value &T
}

fn c2v_pointer_as[T](raw voidptr) &T {
	mut storage := C2vPointerStorage[T]{
		raw: raw
	}
	return unsafe { storage.value }
}

fn c2v_pointer_at[T](base &T, index isize) &T {
	return c2v_pointer_as[T](unsafe { voidptr(usize(voidptr(base)) + usize(index) * usize(sizeof(T))) })
}

fn c2v_cpp_alloc(count usize, size usize) voidptr {
	bytes := count * size
	memory := unsafe { malloc_uncollectable(isize(if bytes == 0 { 1 } else { bytes })) }
	unsafe { C.memset(memory, 0, bytes) }
	return memory
}

fn c2v_new_generic_init() &Generic {
	mut value := unsafe { &Generic(c2v_cpp_alloc(1, usize(sizeof(Generic)))) }
	value.init()
	return value
}

type Callback = fn (voidptr) voidptr

interface Processor {
mut:
	code int
	apply(value f32) f32
	apply2(left f32, right f32) f32
	set_code(value int)
	set_callback(callback fn (voidptr) voidptr)
	get_callback(callback &voidptr)
	log(message &i8, c2v_variadic_args ...voidptr)
}

struct Generic {
	c2v_class u32
mut:
	code int
}

fn (this &Generic) apply(value f32) f32 {
	return value
}

fn (this &Generic) apply2(left f32, right f32) f32 {
	return left + right
}

fn (mut this Generic) set_code(value int) {
	this.code = value
}

fn (this &Generic) set_callback(arg fn (voidptr) voidptr) {
}

fn (this &Generic) get_callback(arg &voidptr) {
}

fn (this &Generic) log(arg &i8, c2v_variadic_args ...voidptr) {
}

fn (mut this Generic) init() {
	this.c2v_class = 2188757914
}

@[markused; weak]
__global processor = c2v_nil_interface[Processor]()

fn init_processor() {
	processor = c2v_new_generic_init()
	processor.set_code(1)
	processor.log(c'ready', voidptr(1))
}

fn run_processor() f32 {
	return processor.apply(2.0) + processor.apply2(3.0, 4.0)
}

fn run_local_processor() f32 {
	mut local := c2v_nil_interface[Processor]()
	local = c2v_new_generic_init()
	return local.apply(1.0)
}

fn run_uninitialized_local_processor() f32 {
	local := c2v_nil_interface[Processor]()
	local = c2v_new_generic_init()
	return local.apply(2.0)
}

fn processor_missing() bool {
	return c2v_interface_is_nil[Processor](processor)
}

fn processor_ready() bool {
	return !c2v_interface_is_nil[Processor](processor)
}

fn processor_truthy(value Processor) bool {
	return if (!c2v_interface_is_nil(value)) { true } else { false }
}

fn processors_match(left Processor, right Processor) bool {
	return c2v_interface_object[Processor](left) == c2v_interface_object[Processor](right)
}

struct ProcessorList {
	item Processor
}

fn (this &ProcessorList) op_index(arg int) Processor {
	return this.item
}

fn read_processor(items &ProcessorList) Processor {
	mut local := items.op_index(0)
	return local
}
